{
  "name": "@ebay-sniper/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./queue": {
      "source": "./src/queue/index.ts",
      "types": "./dist/queue/index.d.ts",
      "default": "./dist/queue/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ebay-sniper/domain": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tdd-guard-vitest": "0.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
