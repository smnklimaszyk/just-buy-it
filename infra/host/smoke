#!/usr/bin/env bash
# Checks a deployed eBay deal monitor from outside: smoke <base-url> <expected-sha>
# Example: infra/host/smoke https://deals.intra-ai.de 0123456789abcdef0123456789abcdef01234567
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: smoke <base-url> <expected-sha>" >&2
  exit 2
fi
base="${1%/}"
expected="$2"
failures=0

# check <name> <detail shown on failure> <test command...>
check() {
  local name="$1" detail="$2"
  shift 2
  if "$@"; then
    echo "ok   $name"
  else
    echo "FAIL $name: $detail"
    failures=$((failures + 1))
  fi
}

status_of() {
  # curl prints 000 when there is no answer.
  curl -sS --max-time 10 -o /dev/null -w '%{http_code}' "$@" 2>/dev/null || true
}

body="$(curl -sS --max-time 10 "$base/healthz" 2>/dev/null || true)"
check "/healthz reports $expected" "got '$body'" [ "$body" = "{\"sha\":\"$expected\"}" ]

code="$(status_of "$base/privacy")"
check "/privacy is 200" "got $code" [ "$code" = 200 ]

# header_of <path> <header name>: that header's lines in the reply to a GET, without carriage returns.
header_of() {
  curl -sS --max-time 10 -o /dev/null -D - "$base$1" 2>/dev/null | tr -d '\r' | grep -i "^$2:" || true
}

# Spec 7.11: both the sign-in page and /privacy lock down default-src and frame-ancestors.
check_strict_csp() {
  local csp strict=no
  csp="$(header_of "$1" content-security-policy)"
  if grep -Eqi "default-src 'none'.*frame-ancestors 'none'" <<<"$csp"; then strict=yes; fi
  check "$1 has a CSP with default-src 'none' and frame-ancestors 'none'" "got '${csp:-no CSP header}'" [ "$strict" = yes ]
}

# server's /privacy has its own CSP since Release 0.
check_strict_csp /privacy

# The sign-in page of the web service (spec 7.2).
code="$(status_of "$base/login")"
check "/login is 200" "got $code" [ "$code" = 200 ]
check_strict_csp /login
frame="$(header_of /login x-frame-options)"
deny=no
if grep -Eqix 'x-frame-options: *deny' <<<"$frame"; then deny=yes; fi
check "/login has X-Frame-Options: DENY" "got '${frame:-no X-Frame-Options header}'" [ "$deny" = yes ]

reply="$(curl -sS --max-time 10 -w '\n%{http_code} %{content_type}' \
  "$base/ebay/account-deletion?challenge_code=smoke" 2>/dev/null || true)"
meta="${reply##*$'\n'}"
challenge=no
if [[ "$meta" == "200 application/json"* && "$reply" == *'"challengeResponse":"'* ]]; then challenge=yes; fi
check "challenge is 200 JSON with challengeResponse" "got '$meta'" [ "$challenge" = yes ]

# ADR 0030: challenge replies must not be cached by a proxy.
cache="$(curl -sS --max-time 10 -o /dev/null -D - "$base/ebay/account-deletion?challenge_code=smoke" 2>/dev/null |
  tr -d '\r' | grep -i '^cache-control:' || true)"
no_store=no
if grep -Eqix 'cache-control: *no-store' <<<"$cache"; then no_store=yes; fi
check "challenge reply has cache-control: no-store" "got '${cache:-no cache-control header}'" [ "$no_store" = yes ]

code="$(status_of "$base/ebay/account-deletion")"
check "challenge without code is 400" "got $code" [ "$code" = 400 ]

# ADR 0013: other methods get 405, never 400.
code="$(status_of -X PUT "$base/ebay/account-deletion")"
check "PUT /ebay/account-deletion is 405" "got $code" [ "$code" = 405 ]

# The endpoint answers 204 before it parses anything; the server counts this one as malformed.
code="$(status_of -X POST -H 'content-type: application/json' --data-binary '{}' "$base/ebay/account-deletion")"
check "POST {} without a signature header is 204" "got $code" [ "$code" = 204 ]

code="$(head -c 71680 /dev/zero | tr '\0' 'x' |
  status_of -X POST -H 'content-type: application/json' --data-binary @- "$base/ebay/account-deletion")"
check "70 KB POST to /ebay/account-deletion is 413" "got $code" [ "$code" = 413 ]

# Spec 7.1: every other path reaches web, which sends a browser without a session to /login. The
# old dashboard paths are among them: they never answer without a session.
for page in / /products /deals /settings /people /candidates /alerts /prices /rejections "/smoke-$RANDOM$RANDOM"; do
  reply="$(curl -sS --max-time 10 -o /dev/null -w '%{http_code} %{redirect_url}' "$base$page" 2>/dev/null || true)"
  check "$page without a session is 303 to /login" "got '$reply'" [ "$reply" = "303 $base/login" ]
done

# curl reports a connect time of 0 when no connection was made (refused or dropped).
host="${base#*://}"
host="${host%%/*}"
host="${host%%:*}"
dashboard_port="${SMOKE_DASHBOARD_PORT:-3142}"
connect="$(curl -s --connect-timeout 5 --max-time 8 -o /dev/null -w '%{time_connect}' \
  "http://$host:$dashboard_port/" 2>/dev/null || true)"
check "port $dashboard_port on $host accepts no connection" "connected in ${connect}s" [ "$connect" = 0.000000 ]

if [[ $failures -gt 0 ]]; then
  echo "$failures check(s) failed"
  exit 1
fi
echo "all checks passed"
