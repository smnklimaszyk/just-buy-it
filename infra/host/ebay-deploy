#!/usr/bin/env bash
# Deploys one commit of the eBay deal monitor on the shared Docker host.
# Install: /usr/local/sbin/ebay-deploy (root, mode 755). Run as root: ebay-deploy <40-character commit sha>
set -euo pipefail

# The healthchecks.io deploy check URL (ADR 0029), empty when there is no ping URL file.
ping_url=""
started=0

# Sends one healthchecks.io ping: start, fail or success. A failed ping only warns and never
# changes the exit code. The URL is not printed: it is the check's only credential.
ping() {
  [[ -n "$ping_url" ]] || return 0
  local suffix="/$1"
  [[ "$1" == success ]] && suffix=""
  curl -fsS --max-time 10 --retry 2 -o /dev/null "$ping_url$suffix" ||
    echo "ebay-deploy: warning: the healthchecks.io $1 ping failed" >&2
}

# After the start ping every failure also sends fail, a rollback included: the new SHA did not go live.
die() {
  echo "ebay-deploy: $*" >&2
  if ((started)); then ping fail; fi
  exit 1
}

sha="${1:-}"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "usage: ebay-deploy <40-character commit sha>"

root="${EBAY_DEPLOY_ROOT:-/opt/ebay-sniper}"
repo="$root/repo"
state="$root/state"
health_url="${EBAY_DEPLOY_HEALTH_URL:-https://deals.intra-ai.de/healthz}"

mkdir -p "$state" "$root/releases"
exec 9>"$state/lock"
flock -n 9 || die "another deploy is running"

running=""
[[ -f "$state/running" ]] && running="$(cat "$state/running")"
if [[ "$sha" == "$running" ]]; then
  echo "ebay-deploy: $sha is already running, nothing to do"
  exit 0
fi

if [[ ! -d "$repo/.git" ]]; then
  echo "ebay-deploy: cloning the repo into $repo"
  git clone --quiet https://github.com/smnklimaszyk/just-buy-it.git "$repo"
fi
git -C "$repo" fetch --quiet origin main
git -C "$repo" merge-base --is-ancestor "$sha" origin/main || die "$sha is not on origin/main, refusing"

# ADR 0011: the secrets file is readable by root only.
[[ "$(stat -c '%U:%G %a' "$root/.env")" == "root:root 600" ]] || die "$root/.env must be root:root 600"
# Compose needs it for every command, and DATABASE_URL embeds it without URL encoding.
grep -Eq '^POSTGRES_PASSWORD=[0-9a-f]+$' "$root/.env" ||
  die "$root/.env must set POSTGRES_PASSWORD to a lowercase hex value (openssl rand -hex 32)"
# The server's DATABASE_URL embeds it the same way; ops migrate sets it as the app role password.
grep -Eq '^POSTGRES_APP_PASSWORD=[0-9a-f]{64}$' "$root/.env" ||
  die "$root/.env must set POSTGRES_APP_PASSWORD to 64 lowercase hex characters (openssl rand -hex 32)"
# The server refuses to start without the external probe's challenge code.
grep -Eq '^DELETION_PROBE_CODE=[A-Za-z0-9_-]{40}$' "$root/.env" ||
  die "$root/.env must set DELETION_PROBE_CODE to 40 characters of [A-Za-z0-9_-] (see the README)"
# The worker's DATABASE_URL and the server's dashboard URL embed these the same way; ops migrate
# sets them as the worker and dashboard role passwords.
for name in POSTGRES_WORKER_PASSWORD POSTGRES_DASHBOARD_PASSWORD; do
  grep -Eq "^$name=[0-9a-f]{64}\$" "$root/.env" ||
    die "$root/.env must set $name to 64 lowercase hex characters (openssl rand -hex 32)"
done
# The worker's item key secret: 32 random bytes in base64, so 43 characters and one "=".
grep -Eq '^ITEM_KEY_V1=[A-Za-z0-9+/]{43}=$' "$root/.env" ||
  die "$root/.env must set ITEM_KEY_V1 to 44 base64 characters (openssl rand -base64 32)"
# The worker refuses a partial SMTP set; an empty value counts as unset, as in the worker.
smtp_missing=()
for name in SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASSWORD ALERT_FROM; do
  grep -Eq "^$name=.+" "$root/.env" || smtp_missing+=("$name")
done
if ((${#smtp_missing[@]} > 0 && ${#smtp_missing[@]} < 5)); then
  missing_list="$(printf '%s, ' "${smtp_missing[@]}")"
  die "$root/.env sets SMTP partially, missing ${missing_list%, } (set all five or none)"
fi

# The healthchecks.io deploy check is optional; its URL file is root-only like .env.
ping_file="$root/deploy-ping-url"
if [[ -e "$ping_file" ]]; then
  [[ "$(stat -c '%U:%G %a' "$ping_file")" == "root:root 600" ]] || die "$ping_file must be root:root 600"
  ping_url="$(cat "$ping_file")"
  [[ "$ping_url" =~ ^https://[^[:space:]]+$ ]] || die "$ping_file must hold one https:// URL on one line"
else
  echo "ebay-deploy: no deploy ping URL, skipping healthchecks.io pings"
fi
started=1
ping start

release="$root/releases/$sha"
rm -rf "$release"
mkdir -p "$release"
git -C "$repo" archive --format=tar "$sha" | tar -x -C "$release"
echo "ebay-deploy: exported $sha to $release"

# Runs docker compose for the release of the SHA in $1 with the rest of the arguments.
compose() {
  GIT_SHA="$1" docker compose -p ebay-sniper --env-file "$root/.env" \
    -f "$root/releases/$1/infra/docker-compose.yml" "${@:2}"
}

# Only the server: a Postgres health flap must not fail or roll back a healthy server.
compose_up() {
  compose "$1" up -d --build --wait --wait-timeout 120 server
}

# Polls /healthz for at most 60 seconds (20 tries of up to 2 s plus 1 s pause).
serves() {
  local try body
  for ((try = 0; try < 20; try++)); do
    body="$(curl -fsS --max-time 2 "$health_url" 2>/dev/null || true)"
    [[ "$body" == "{\"sha\":\"$1\"}" ]] && return 0
    sleep 1
  done
  return 1
}

# Keeps the five newest release directories plus the running and previous ones.
prune() {
  local keep dir name
  # shellcheck disable=SC2012 # release names are hex SHAs
  keep=" $(ls -1t "$root/releases" | sed -n '1,5p' | tr '\n' ' ') $sha $running "
  for dir in "$root/releases"/*/; do
    name="$(basename "$dir")"
    case "$keep" in
      *" $name "*) ;;
      *) rm -rf "$dir" && echo "ebay-deploy: removed old release $name" ;;
    esac
  done
}

compose "$sha" build server || die "build of $sha failed, the running release is unchanged"

echo "ebay-deploy: postgres: applying the config of $sha"
compose "$sha" up -d --wait --wait-timeout 120 postgres ||
  die "postgres for $sha is not healthy, the server still runs the old release"

# The compose function cannot run under timeout, so the call is spelled out.
echo "ebay-deploy: migrate: running the migrations of $sha"
migrate_status=0
timeout 900 env GIT_SHA="$sha" docker compose -p ebay-sniper --env-file "$root/.env" \
  -f "$root/releases/$sha/infra/docker-compose.yml" run --rm --no-deps -T migrate || migrate_status=$?
if ((migrate_status == 124)); then
  # timeout stops the compose client, not the one-off container it started.
  docker ps -q --filter label=com.docker.compose.project=ebay-sniper \
    --filter label=com.docker.compose.service=migrate --filter label=com.docker.compose.oneoff=True |
    xargs -r docker stop >/dev/null ||
    echo "ebay-deploy: could not stop the leftover migrate container, check docker ps" >&2
  die "migration for $sha timed out after 900 s, the running release is unchanged"
fi
((migrate_status == 0)) ||
  die "migration for $sha failed (exit $migrate_status), the running release is unchanged"

# True when the release of the SHA in $1 defines a worker service. The output is read whole
# before grep, so an early grep exit cannot fail the pipe.
has_worker() {
  local services
  services="$(compose "$1" config --services 2>/dev/null)" || return 1
  grep -qx worker <<<"$services"
}

# --wait waits for the worker's healthcheck (the heartbeat file, healthy about 30 s after start).
worker_up() {
  compose "$1" up -d --no-deps --wait --wait-timeout 90 worker
}

# Stops every worker container of the project, whichever release started it.
stop_worker() {
  docker ps -q --filter label=com.docker.compose.project=ebay-sniper \
    --filter label=com.docker.compose.service=worker | xargs -r docker stop >/dev/null
}

# Puts the running release's worker back, or stops the new one when that release has none.
worker_back() {
  if has_worker "$running"; then
    worker_up "$running"
    return
  fi
  echo "ebay-deploy: $running has no worker, stopping the worker container"
  stop_worker
}

# Rolls back to the running release and exits 1. $1 is "server" when only the server was
# replaced, "worker" when the worker was replaced too.
roll_back() {
  if [[ -n "$running" ]]; then
    echo "ebay-deploy: rolling back to $running"
    if compose_up "$running" && serves "$running" && { [[ "$1" == server ]] || worker_back; }; then
      die "deploy of $sha failed, rolled back to $running"
    fi
    die "deploy of $sha failed and the rollback to $running failed too, check the host now"
  fi
  # Run from / so compose does not pick up a compose file from the caller's directory.
  (cd / && docker compose -p ebay-sniper down) || echo "ebay-deploy: docker compose down failed" >&2
  die "deploy of $sha failed, no previous release, stopped the new containers"
}

# The server first, as before; the worker is not touched until the new server serves.
echo "ebay-deploy: starting $sha"
if ! { compose_up "$sha" && serves "$sha"; }; then
  echo "ebay-deploy: $sha failed to start or /healthz did not report it within 60 s" >&2
  roll_back server
fi

# Migrations are expand-only, so the old worker ran against the new schema until now.
if has_worker "$sha"; then
  echo "ebay-deploy: starting the worker of $sha"
  if ! worker_up "$sha"; then
    echo "ebay-deploy: the worker of $sha did not get healthy within 90 s" >&2
    roll_back worker
  fi
else
  # A release from before the worker (a rollback by hand to an older SHA): a worker left by a
  # newer release would keep polling eBay, calling Claude and sending email next to it.
  echo "ebay-deploy: $sha has no worker, stopping the worker container"
  stop_worker || echo "ebay-deploy: warning: could not stop the worker container, check docker ps" >&2
fi

[[ -n "$running" ]] && echo "$running" >"$state/previous"
echo "$sha" >"$state/running"
prune
echo "ebay-deploy: $sha is live"
ping success
exit 0
