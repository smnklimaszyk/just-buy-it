# Production lives in /opt/ebay-sniper/.env on the server (root only, mode 600). Never commit real values.
# Values must not contain $: Compose interpolates them into the server, worker and migrate settings.
# Nothing may source this file in a shell: ALERT_FROM holds spaces and angle brackets unquoted.
EBAY_ENVIRONMENT=production
EBAY_DELETION_ENDPOINT_URL=https://deals.intra-ai.de/ebay/account-deletion
# 32 to 80 characters of [A-Za-z0-9_-]; generate with: openssl rand -hex 32
EBAY_DELETION_VERIFICATION_TOKEN=
# Production keyset: App ID (client id) and Cert ID (client secret). The worker needs both for Browse calls.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Postgres password for the ebay_sniper role; used only on first start of the volume and by
# Compose to build DATABASE_URL. Must be hex: openssl rand -hex 32
POSTGRES_PASSWORD=
# Password of the app role the server connects as; 64 hex characters: openssl rand -hex 32
POSTGRES_APP_PASSWORD=
# Challenge code of the external probe, 40 characters: openssl rand -base64 30 | tr '+/' '-_' | tr -d '\n'
DELETION_PROBE_CODE=
# Password of the worker role the worker connects as; 64 hex characters: openssl rand -hex 32
POSTGRES_WORKER_PASSWORD=
# Password of the read-only dashboard role; 64 hex characters: openssl rand -hex 32
POSTGRES_DASHBOARD_PASSWORD=
# Secret for the item keys (ADR 0013), 32 random bytes: openssl rand -base64 32
ITEM_KEY_V1=
# Claude screening; empty: alerts say "Not screened by Claude: not_configured"
ANTHROPIC_API_KEY=
# Optional: only claude-sonnet-5-5 is accepted
CLAUDE_MODEL=
# Claude calls per Berlin day, default 40; 0 switches screening off
CLAUDE_DAILY_CALL_LIMIT=40
# Claude spend per Berlin day in USD, default 2, at most 2 decimal places; 0 switches screening off
CLAUDE_DAILY_SPEND_LIMIT_USD=2
# Alert email over SMTP: all five or none. Port 587 uses STARTTLS. Empty: alerts stay pending.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# A bare address or a display name with the address, unquoted, e.g. Just-Buy-It <info@intra-ai.de>
ALERT_FROM=
# Recipient of every alert email
ALERT_TO=
# Optional worker settings; empty means the default
# company (default) or private: changes the VAT line in the email only
BUYER_PROFILE=
# Postal code for the eBay end-user context header, default 80331
EBAY_ENDUSERCTX_POSTAL_CODE=
# Worker statement timeout in milliseconds, default 10000
DB_STATEMENT_TIMEOUT_MS=
# Worker log level, default info
LOG_LEVEL=
