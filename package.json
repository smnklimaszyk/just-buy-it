    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
